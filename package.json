{
  "name": "AtCoDaily-bot",
  "version": "0.1.0",
  "description": "Post AtCoder problem everyday in Discord",
  "main": "index.js",
  "scripts": {
    "build": "tsx build.ts",
    "check:type": "tsc --noEmit",
    "check:format": "biome format ./src",
    "format": "biome format --write ./src",
    "check:lint": "biome check ./src",
    "lint": "biome check --write ./src",
    "test": "vitest",
    "postinstall": "lefthook install",
    "dev": "tsx --env-file=.env src/main.ts"
  },
  "type": "module",
  "keywords": [],
  "author": "Alliana",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@effect/vitest": "^0.23.0",
    "@types/node": "^22.9.0",
    "commitlint": "^19.5.0",
    "esbuild": "^0.25.0",
    "lefthook": "^1.8.2",
    "node-html-parser": "^7.0.0",
    "prisma": "^6.0.0",
    "ts-pattern": "^5.5.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@effect/platform": "^0.82.0",
    "@effect/platform-node": "^0.80.0",
    "@prisma/client": "6.7.0",
    "discord.js": "^14.16.3",
    "effect": "^3.10.15"
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}
