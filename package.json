{
  "name": "AtCoDaily-bot",
  "version": "0.1.0",
  "description": "Post AtCoder problem everyday in Discord",
  "main": "index.js",
  "scripts": {
    "build": "tsx build.ts",
    "check:type": "tsc --noEmit",
    "check:format": "biome format ./src",
    "format": "biome format --write ./src",
    "check:lint": "biome check ./src",
    "lint": "biome check --write ./src",
    "test": "vitest",
    "postinstall": "lefthook install",
    "dev": "tsx --env-file=.env src/main.ts"
  },
  "type": "module",
  "keywords": [],
  "author": "Alliana",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@effect/vitest": "^0.23.0",
    "@types/node": "^22.9.0",
    "commitlint": "^19.5.0",
    "esbuild": "^0.25.0",
    "lefthook": "^1.8.2",
    "node-html-parser": "^7.0.0",
    "prisma": "^6.0.0",
    "ts-pattern": "^5.5.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@effect/platform": "^0.82.0",
    "@effect/platform-node": "^0.80.0",
    "@prisma/client": "6.7.0",
    "discord.js": "^14.16.3",
    "effect": "^3.10.15"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
